# ==== IA (conta da plataforma) ====
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ==== Banco de dados ====
# Postgres (Railway: ${{Postgres.DATABASE_URL}}). Sem ele, usa SQLite em /data/crm_multi.db.
DATABASE_URL=

# ==== Acesso ====
# Login da administradora da plataforma (você). Sem ADMIN_EMAIL, o login é "admin".
ADMIN_EMAIL=voce@suaempresa.com
ADMIN_SENHA=troque-esta-senha
# Chave que assina os logins. Gere uma longa e aleatória e não mude (se mudar, todos precisam entrar de novo).
SECRET_KEY=

# ==== WhatsApp: app da Meta da plataforma (um só para todas as empresas) ====
WHATSAPP_VERIFY_TOKEN=lothem-crm-2026
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
# Número da empresa nº 1 (as outras empresas cadastram o delas em Configurações)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Segundos que a IA espera o cliente terminar de digitar antes de agir
DEBOUNCE_SEGUNDOS=8
