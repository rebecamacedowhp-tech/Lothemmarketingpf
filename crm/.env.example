# ==== Claude (a SDR IA) ====
# Crie a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelo e "esforço" de raciocínio da SDR (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# ==== WhatsApp Business (Cloud API da Meta) ====
# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Palavra secreta que você inventa e cola também no painel da Meta (Webhook > Verify token)
WHATSAPP_VERIFY_TOKEN=lothem-crm-2026
# App secret (Meta > Configurações do app > Básico). Usado para validar que o webhook veio da Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ==== CRM ====
# Senha para abrir o painel (usuário: qualquer um). Deixe vazio só para teste local.
CRM_SENHA=troque-esta-senha
CRM_DB=crm.db
# Segundos que a IA espera o cliente terminar de digitar antes de responder
# (junta várias mensagens seguidas numa resposta só)
DEBOUNCE_SEGUNDOS=8
